{
  "name": "@foundry/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "audit:baseline:update": "node scripts/update-audit-baseline.mjs",
    "audit:app-boundary": "node scripts/audit-app-boundary.mjs",
    "audit:component-boundaries": "node scripts/audit-component-boundaries.mjs",
    "audit:feature-architecture": "node scripts/audit-feature-architecture.mjs",
    "audit:css": "node scripts/audit-css-constraints.mjs",
    "audit:inline-styles": "node scripts/audit-inline-styles.mjs",
    "audit:native-controls": "node scripts/audit-native-controls.mjs",
    "audit:v3-layout": "node scripts/audit-v3-layout-contract.mjs",
    "audit:web-entry": "node scripts/audit-web-entry.mjs",
    "audit:ui": "pnpm audit:buttons && pnpm audit:native-controls && pnpm audit:app-boundary && pnpm audit:component-boundaries && pnpm audit:feature-architecture && pnpm audit:inline-styles && pnpm audit:css && pnpm audit:v3-layout && pnpm audit:web-entry",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm --filter @foundry/protocol build",
    "predev": "pnpm --filter @foundry/protocol build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@foundry/protocol": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.0.0",
    "react-virtuoso": "4.18.12",
    "streamdown": "2.6.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.13.2"
  }
}
