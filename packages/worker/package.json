{
  "name": "@bd777/foundry-worker",
  "version": "0.5.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BD777/foundry.git",
    "directory": "packages/worker"
  },
  "homepage": "https://github.com/BD777/foundry#readme",
  "description": "Local Foundry worker daemon and workspace CLI",
  "type": "module",
  "bin": {
    "foundry-worker": "./dist/cli.js",
    "foundry": "./dist/foundry-cli.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/watchdog.sh"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "foundry-worker": "node scripts/run-cli.mjs",
    "prepack": "pnpm build",
    "test": "pnpm --filter @bd777/foundry-protocol build && pnpm build && node scripts/run-worker-tests.mjs",
    "test:probe": "node scripts/run-worker-tests.mjs --probe",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@bd777/foundry-protocol": "workspace:*",
    "@openai/codex": "0.142.5",
    "@openai/codex-sdk": "^0.142.5",
    "pdfjs-dist": "^6.3.289",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
