            "primary",
            "supporting",
            "stdout",
            "stderr",
            "report",
            "request",
            "response",
            "trace"
          ]
        }
      }
    },
    "EvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producer"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tool_capture",
            "candidate_export",
            "human_upload",
            "agent_authored"
          ]
        },
        "producer": { "$ref": "#/$defs/ActorRef" },
        "deviceId": { "type": "string" },
        "runId": { "type": "string" },
        "sessionId": { "type": "string" },
        "toolCallId": { "type": "string" }
      }
    },
    "CollectionRecordError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "CollectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "collectorName",
        "collectorVersion",
        "inputMaterialId",
        "startedAt",
        "finishedAt",
        "outcome",
        "completeness"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "command",
            "http",
            "file_export",
            "upload",
            "agent_generation"
          ]
        },
        "collectorName": { "type": "string" },
        "collectorVersion": { "type": "string" },
        "inputMaterialId": { "type": "string" },
        "startedAt": { "$ref": "#/$defs/DateTime" },
        "finishedAt": { "$ref": "#/$defs/DateTime" },
        "outcome": {
          "type": "string",
          "enum": ["completed", "failed", "timed_out", "canceled"]
        },
        "exitCode": { "type": "integer" },
        "httpStatus": { "type": "integer" },
        "error": { "$ref": "#/$defs/CollectionRecordError" },
        "completeness": {
          "type": "string",
          "enum": ["complete", "truncated", "partial"]
        }
      }
    },
    "EvidenceBindingAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "at", "statement"],
      "properties": {
        "actor": { "$ref": "#/$defs/ActorRef" },
        "at": { "$ref": "#/$defs/DateTime" },
        "statement": { "type": "string", "minLength": 1, "format": "non-blank" }
      }
    },
    "Evidence": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": [
            "title",
            "description",
            "verificationInputId",
            "claims",
            "materials",
            "source",
            "collection",
            "candidateBinding"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "format": "non-blank"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "format": "non-blank"
            },
            "verificationInputId": { "type": "string" },
            "claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidenceClaim" }
            },
            "materials": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidenceMaterialRef" }
            },
            "source": { "$ref": "#/$defs/EvidenceSource" },
            "collection": { "$ref": "#/$defs/CollectionRecord" },
            "candidateBinding": {
              "type": "string",
              "enum": ["system_observed", "human_attested"]
            },
            "bindingAttestation": {
              "$ref": "#/$defs/EvidenceBindingAttestation"
            },
            "supersedesEvidenceId": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "VerifierIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/VerifierIdentityProgram" },
        { "$ref": "#/$defs/VerifierIdentityAgent" }
      ],
      "discriminator": { "propertyName": "kind" }
    },
    "VerifierIdentityProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "checkerDigest"],
      "properties": {
        "kind": { "type": "string", "enum": ["program"] },
        "name": { "type": "string", "minLength": 1, "format": "non-blank" },
        "version": { "type": "string" },
        "checkerDigest": { "type": "string" }
      }
    },
    "VerifierIdentityAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "harness",
        "profileId",
        "requestedModel",
        "sessionId",
        "promptTemplateVersion",
        "promptDigest",
        "isolated"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["agent"] },
        "harness": { "type": "string", "enum": ["claude", "codex"] },
        "profileId": { "type": "string" },
        "requestedModel": { "type": "string" },
        "reportedModel": { "type": "string" },
        "sessionId": { "type": "string" },
        "promptTemplateVersion": { "type": "string" },
        "promptDigest": { "type": "string" },
        "isolated": { "type": "boolean", "enum": [true] }
      }
    },
    "EvidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "materialId"],
      "properties": {
        "evidenceId": { "type": "string" },
        "materialId": {
          "type": "string",
          "minLength": 1,
          "format": "non-blank"
        },
        "selector": { "$ref": "#/$defs/MaterialSelector" }
      }
    },
    "ReferenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId"],
      "properties": {
        "materialId": {
          "type": "string",
          "minLength": 1,
          "format": "non-blank"
        },
        "selector": { "$ref": "#/$defs/MaterialSelector" }
      }
    },
    "VerificationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "expected",
        "observed",
        "verdict",
        "evidenceCitations",
        "referenceCitations"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "format": "non-blank" },
        "statement": {
          "type": "string",
          "minLength": 1,
          "format": "non-blank"
        },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "evidenceCitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceCitation" }
        },
        "referenceCitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReferenceCitation" }
        }
      }
    },
    "VerificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary",
        "reasoning",
        "findings",
        "limitations",
        "unmetRequirementIds",
        "rawOutputMaterialId",
        "reportMaterialId",
        "completedAt"
      ],
      "properties": {
        "verdict": { "$ref": "#/$defs/Verdict" },
        "summary": { "type": "string" },
        "reasoning": { "type": "string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/VerificationFinding" }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "unmetRequirementIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rawOutputMaterialId": { "type": "string" },
        "reportMaterialId": { "type": "string" },
        "completedAt": { "$ref": "#/$defs/DateTime" }
      }
    },
    "VerificationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "Verification": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": [
            "sequence",
            "criterionId",
            "contractRevision",
            "verificationInputId",
            "evidenceIds",
            "mode",
            "executor",
            "status"
          ],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 },
            "criterionId": {
              "type": "string",
              "minLength": 1,
              "format": "non-blank"
            },
            "contractRevision": { "type": "integer" },
            "verificationInputId": { "type": "string" },
            "evidenceIds": { "type": "array", "items": { "type": "string" } },
            "mode": { "$ref": "#/$defs/EvaluationMode" },
            "executor": { "$ref": "#/$defs/VerifierIdentity" },
            "status": {
              "type": "string",
              "enum": ["queued", "running", "completed", "failed", "canceled"]
            },
            "startedAt": { "$ref": "#/$defs/DateTime" },
            "finishedAt": { "$ref": "#/$defs/DateTime" },
            "result": { "$ref": "#/$defs/VerificationResult" },
            "error": { "$ref": "#/$defs/VerificationError" },
            "supersedesVerificationId": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "HumanAssessment": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": [
            "criterionId",
            "contractRevision",
            "verificationInputId",
            "verificationId",
            "verdict",
            "rationale",
            "evidenceCitations"
          ],
          "properties": {
            "criterionId": {
              "type": "string",
              "minLength": 1,
              "format": "non-blank"
            },
            "contractRevision": { "type": "integer" },
            "verificationInputId": { "type": "string" },
            "verificationId": { "type": "string" },
            "verdict": { "$ref": "#/$defs/Verdict" },
            "rationale": { "$ref": "#/$defs/RichContent" },
            "evidenceCitations": {
              "type": "array",
              "items": { "$ref": "#/$defs/EvidenceCitation" }
            },
            "supersedesAssessmentId": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CriterionReviewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "evidenceIds",
        "effectiveVerdict",
        "authority",
        "freshness",
        "evidenceAvailability",
        "reasons"
      ],
      "properties": {
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "format": "non-blank"
        },
        "verificationId": { "type": "string" },
        "humanAssessmentId": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "effectiveVerdict": {
          "type": "string",
          "enum": ["pass", "fail", "inconclusive", "not_evaluated"]
        },
        "authority": {
          "type": "string",
          "enum": ["program", "agent_preliminary", "human", "none"]
        },
        "freshness": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown"]
        },
        "evidenceAvailability": {
          "type": "string",
          "enum": ["available", "unavailable"]
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ReviewBlockerCode": {
      "type": "string",
      "enum": [
        "contract_unconfirmed",
        "contract_amendment_pending",
        "checker_missing",
        "verification_pending",
        "verification_error",
        "required_failed",
        "required_inconclusive",
        "evidence_missing",
        "input_unbound",
        "stale",
        "material_unavailable",
        "candidate_changed",
        "baseline_changed"
      ]
    },
    "ReviewBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/ReviewBlockerCode" },
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "format": "non-blank"
        },
        "message": { "type": "string" }
      }
    },
    "ExitRuleResult": {
      "description": "One numbered exit rule of a review: every rule must hold before Accept. The rule set is versioned; a review records the version it was judged by.\n",
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "satisfied", "blockerCodes"],
      "properties": {
        "ruleId": {
          "type": "string",
          "enum": ["R1", "R2", "R3", "R4", "R5", "R6"]
        },
        "satisfied": { "type": "boolean" },
        "blockerCodes": {
          "description": "The blockers that keep the rule from holding.",
          "type": "array",
          "items": { "$ref": "#/$defs/ReviewBlockerCode" }
        }
      }
    },
    "ExitRuleResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "results"],
      "properties": {
        "version": { "type": "string" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExitRuleResult" }
        }
      }
    },
    "ReviewSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": [
            "contractRevision",
            "candidateSnapshotId",
            "criterionResults",
            "blockingReasons",
            "eligible",
            "digest"
          ],
          "properties": {
            "contractRevision": { "type": "integer" },
            "candidateSnapshotId": { "type": "string" },
            "criterionResults": {
              "type": "array",
              "items": { "$ref": "#/$defs/CriterionReviewEntry" }
            },
            "blockingReasons": {
              "type": "array",
              "items": { "$ref": "#/$defs/ReviewBlocker" }
            },
            "exitRules": {
              "description": "Absent on reviews made before exit rules were recorded.",
              "$ref": "#/$defs/ExitRuleResults"
            },
            "eligible": { "type": "boolean" },
            "digest": { "$ref": "#/$defs/Digest" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "AcceptanceDecision": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": [
            "reviewSnapshotId",
            "reviewDigest",
            "contractRevision",
            "candidateSnapshotId",
            "status"
          ],
          "properties": {
            "reviewSnapshotId": { "type": "string" },
            "reviewDigest": { "$ref": "#/$defs/Digest" },
            "contractRevision": { "type": "integer" },
            "candidateSnapshotId": { "type": "string" },
            "rationale": { "$ref": "#/$defs/RichContent" },
            "status": {
              "type": "string",
              "enum": ["approved", "invalidated", "integrated"]
            },
            "invalidatedAt": { "$ref": "#/$defs/DateTime" },
            "invalidationReason": { "type": "string" },
            "integrationId": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "AuditEventSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string", "minLength": 1, "format": "non-blank" }
      }
    },
    "AuditEvent": {
      "allOf": [
        { "$ref": "#/$defs/EvidenceRecord" },
        {
          "type": "object",
          "required": ["sequence", "action", "subject", "requestId"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 1 },
            "action": {
              "type": "string",
              "enum": [
                "contract_proposed",
                "contract_confirmed",
                "contract_discarded",
                "evidence_registered",
                "verification_requested",
                "verification_completed",
                "verification_failed",
                "human_assessed",
                "acceptance_approved",
                "acceptance_invalidated",
                "integration_started",
                "integration_completed",
                "integration_failed",
                "material_availability_changed",
                "candidate_sealed"
              ]
            },
            "subject": { "$ref": "#/$defs/AuditEventSubject" },
            "beforeDigest": { "$ref": "#/$defs/Digest" },
            "afterDigest": { "$ref": "#/$defs/Digest" },
            "reason": { "type": "string" },
            "requestId": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "VerificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTotal",
        "passed",
        "failed",
        "inconclusive",
        "pending",
        "stale",
        "eligible"
      ],
      "properties": {
        "requiredTotal": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "inconclusive": { "type": "integer" },
        "pending": { "type": "integer" },
        "stale": { "type": "integer" },
        "eligible": { "type": "boolean" }
      }
    },
    "ContractDraftInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "baseRevision": { "type": "integer" },
        "content": { "$ref": "#/$defs/ContractContent" },
        "changeReason": { "type": "string" }
      }
    },
    "CheckAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected", "observed", "verdict"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "format": "non-blank" },
        "expected": { "$ref": "#/$defs/JSONValue" },
        "observed": { "$ref": "#/$defs/JSONValue" },
        "verdict": { "$ref": "#/$defs/Verdict" }
      }
    },
    "CheckReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertions"],
      "properties": {
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/CheckAssertion" }
        }
      }
    }
  }
}
