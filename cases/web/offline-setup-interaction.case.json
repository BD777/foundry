{
  "version": 1,
  "id": "web.offline-setup-interaction",
  "title": "Offline setup can enter the workspace without a server mutation",
  "description": "The local-first setup page explains the trust boundary and its simulation action transitions to the issue workspace using semantic controls.",
  "kind": "browser-interaction",
  "area": "web-app",
  "risk": "medium",
  "cadence": ["pull-request", "release", "manual"],
  "tags": ["setup", "navigation", "local-first"],
  "preconditions": [
    "Start web and server with an isolated database.",
    "Open a fresh browser tab so device simulation state is reset."
  ],
  "environment": {
    "baseUrl": "http://127.0.0.1:31983",
    "route": "/?device=offline",
    "fixture": "offline-device",
    "colorScheme": "light",
    "viewport": { "width": 1440, "height": 1000 }
  },
  "steps": [
    { "id": "open", "action": "navigate", "target": "/?device=offline" },
    {
      "id": "inspect-trust-copy",
      "action": "inspect",
      "target": "text=the server only coordinates and never sees your credentials"
    },
    {
      "id": "simulate-online",
      "action": "click",
      "target": "role=button[name='Simulate device online']"
    }
  ],
  "assertions": [
    {
      "afterStep": "open",
      "type": "visible",
      "target": "role=heading[name='Connect a device']"
    },
    {
      "afterStep": "inspect-trust-copy",
      "type": "visible",
      "target": "trust-boundary explanation"
    },
    {
      "afterStep": "simulate-online",
      "type": "hidden",
      "target": "role=heading[name='Connect a device']"
    },
    {
      "afterStep": "simulate-online",
      "type": "visible",
      "target": "role=button[name='Add Inbox issue']"
    },
    {
      "afterStep": "simulate-online",
      "type": "no-console-errors",
      "target": "browser console"
    }
  ],
  "automation": {
    "status": "manual",
    "runner": "browser",
    "references": [
      "apps/web/src/App.tsx",
      "apps/web/src/components/ui/setup-flow.tsx",
      "apps/web/src/features/issues/issue-workspace.tsx"
    ]
  },
  "evidence": { "capture": ["console", "screenshot"], "retainOn": "failure" },
  "cleanup": ["Close the test tab and stop isolated services."]
}
