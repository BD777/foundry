{
  "version": 1,
  "id": "web.offline-setup-mobile-visual",
  "title": "Offline setup remains usable on a narrow mobile viewport",
  "description": "The onboarding copy, commands, and primary action remain visible and horizontally contained at the supported mobile checkpoint.",
  "kind": "browser-visual",
  "area": "web-app",
  "risk": "medium",
  "cadence": ["release", "manual"],
  "tags": ["visual", "setup", "responsive"],
  "preconditions": [
    "Start web and server with an isolated database.",
    "Reset theme to light."
  ],
  "environment": {
    "baseUrl": "http://127.0.0.1:31983",
    "route": "/?device=offline",
    "fixture": "offline-device",
    "colorScheme": "light",
    "viewport": { "width": 390, "height": 844 }
  },
  "steps": [
    { "id": "open", "action": "navigate", "target": "/?device=offline" },
    {
      "id": "capture",
      "action": "inspect",
      "target": "full-page mobile screenshot after layout settles"
    }
  ],
  "assertions": [
    {
      "afterStep": "open",
      "type": "visible",
      "target": "role=heading[name='Connect a device']"
    },
    {
      "afterStep": "open",
      "type": "visible",
      "target": "role=button[name='Simulate device online']"
    },
    {
      "afterStep": "capture",
      "type": "no-horizontal-overflow",
      "target": "document"
    },
    {
      "afterStep": "capture",
      "type": "no-console-errors",
      "target": "browser console"
    },
    {
      "afterStep": "capture",
      "type": "screenshot-match",
      "target": "offline-setup-light-mobile"
    }
  ],
  "automation": {
    "status": "manual",
    "runner": "browser",
    "references": [
      "apps/web/src/components/ui/setup-flow.tsx",
      "apps/web/src/styles/90-responsive.css"
    ]
  },
  "evidence": { "capture": ["console", "screenshot"], "retainOn": "always" },
  "visual": {
    "baseline": "offline-setup-light-mobile",
    "maxPixelDiffRatio": 0.01,
    "masks": []
  },
  "cleanup": [
    "Restore the desktop viewport, close the test tab, and stop isolated services."
  ]
}
