{
  "version": 1,
  "id": "web.issue-conversation",
  "title": "Issue conversation, states and candidate inspector",
  "description": "One Issue keeps its conversation across execution, steer, interruption and review while sharing the Chat reading surface.",
  "kind": "browser-interaction",
  "area": "issue-loop",
  "risk": "high",
  "cadence": ["pull-request", "release", "manual"],
  "tags": ["issue", "chat", "steer", "recovery"],
  "preconditions": [
    "Start the Vite web development server. The isolated fixture replaces HTTP transport and never starts a real provider."
  ],
  "environment": {
    "baseUrl": "http://127.0.0.1:31983",
    "route": "/test/issue-detail.html",
    "fixture": "issue-conversation",
    "colorScheme": "light",
    "viewport": {
      "width": 1280,
      "height": 720
    }
  },
  "steps": [
    {
      "id": "open",
      "action": "navigate",
      "target": "/test/issue-detail.html"
    },
    {
      "id": "changes",
      "action": "click",
      "target": "role=button[name='改动']"
    },
    {
      "id": "feedback",
      "action": "click",
      "target": "role=button[name='要求修改']"
    },
    {
      "id": "type",
      "action": "type",
      "target": "role=textbox[name='Issue follow-up']",
      "value": "Improve the empty state"
    },
    {
      "id": "send",
      "action": "click",
      "target": "role=button[name='Send issue message']"
    }
  ],
  "assertions": [
    {
      "afterStep": "changes",
      "type": "visible",
      "target": "text=Workspace candidate · revision 2"
    },
    {
      "afterStep": "send",
      "type": "visible",
      "target": "text=Continued: Improve the empty state"
    },
    {
      "afterStep": "send",
      "type": "visible",
      "target": "text=In progress"
    },
    {
      "afterStep": "send",
      "type": "no-console-errors",
      "target": "browser console"
    }
  ],
  "automation": {
    "status": "manual",
    "runner": "browser",
    "references": [
      "apps/web/test/issue-detail.tsx",
      "apps/web/test/issue-conversation.test.mjs",
      "apps/web/test/issue-transcript.test.mjs",
      "packages/worker/test/issue-steering.test.mjs",
      "apps/server/internal/httpapi/issue_environment_test.go",
      "apps/server/internal/sqlitestore/issue_runs_test.go"
    ]
  },
  "evidence": {
    "capture": ["console", "screenshot"],
    "retainOn": "failure"
  },
  "cleanup": [
    "Close the fixture. Remove only its foundry.issue-draft:issue_test local draft if retained."
  ]
}
