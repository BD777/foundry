  "automation": {
    "status": "automated",
    "runner": "repo-script",
    "command": "node scripts/audit-contract.mjs",
    "references": [
      "scripts/audit-contract.mjs",
      "packages/protocol/src",
      "packages/worker/src/daemon-connection.ts",
      "apps/server/internal/httpapi/daemon_ws.go"
